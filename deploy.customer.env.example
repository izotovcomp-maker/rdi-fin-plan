# Образец deploy.customer.env — деплой на сервер ЗАКАЗЧИКА (SSH + rsync).
# Копия без ".example" лежит в корне проекта, В GIT НЕ ПОПАДАЕТ (.gitignore).
# Пароли и ключи сюда не пишем — только путь к файлу ключа.
# Заполняется после того, как заказчик выполнил команды из docs/how-to-link.md
# и прислал данные сервера. Формат — shell, как в mydeploy.env, но префикс CUSTOMER_.

CUSTOMER_MODE=ssh
CUSTOMER_SSH_HOST=server.customer.example
CUSTOMER_SSH_PORT=22
CUSTOMER_SSH_USER=iagdeploy
CUSTOMER_SSH_KEY="$HOME/.ssh/iagdeploy_ed25519"
CUSTOMER_PUBLIC_BASE_URL=https://apps.customer.example   # без слеша; /<slug> добавится
CUSTOMER_DEPLOY_ROOT=/var/www/b24                         # проект = $DEPLOY_ROOT/<slug>
CUSTOMER_WEB_GROUP=www-data                               # www-data (Debian/Ubuntu), nginx, apache
CUSTOMER_DATA_MODE=2770
CUSTOMER_PHP_BIN=php8.3
CUSTOMER_WEB_SERVER=caddy                                 # caddy | nginx | apache — для подсказок
CUSTOMER_CADDYFILE=/etc/caddy/Caddyfile
CUSTOMER_PHP_FPM_SOCK=/run/php/php8.3-fpm.sock
CUSTOMER_CADDY_RELOAD_CMD="sudo caddy reload --config /etc/caddy/Caddyfile"
