# Образец /projects/mydeploy.env — профили деплоя ВАШИХ серверов (единое место).
# Скопируй в /projects/mydeploy.env (вне репозиториев) и впиши свои значения.
# Читается deploy.sh через source: формат shell, KEY=VALUE, без пробелов вокруг "=".
# Секретов тут нет — только путь к SSH-ключу. Не коммитить реальный файл.
#
# Профиль выбирается файлом .deploy-target в корне проекта (prod | lab | customer);
# нет файла — prod. Сервер заказчика — не здесь, а в deploy.customer.env проекта
# (образец: deploy.customer.env.example).
#
# Переменные профиля (префикс PROD_ / LAB_):
#   MODE             local — rsync на этой же машине; ssh — rsync по SSH
#   SSH_HOST/PORT/USER/KEY   только для ssh. USER — отдельный пользователь для деплоя
#                    без sudo и пароля; KEY — путь к приватному ключу
#   PUBLIC_BASE_URL  https://домен, без слеша на конце; к нему добавляется /<slug>
#   DEPLOY_ROOT      каталог проектов на сервере: проект = $DEPLOY_ROOT/<slug>
#   WEB_GROUP        группа PHP-FPM (www-data / nginx / apache); пусто = группу не менять
#   DATA_MODE        права на data/ (рекомендуется 2770 при заданной WEB_GROUP)
#   PHP_BIN          бинарник PHP (для команды cron в подсказках)
#   CADDYFILE, PHP_FPM_SOCK, CADDY_RELOAD_CMD   только для подсказки по блоку Caddy

PROD_MODE=ssh
PROD_SSH_HOST=prod.example.com
PROD_SSH_PORT=22
PROD_SSH_USER=deployuser
PROD_SSH_KEY="$HOME/.ssh/deploy_ed25519"
PROD_PUBLIC_BASE_URL=https://prod.example.com
PROD_DEPLOY_ROOT=/var/www/b24
PROD_WEB_GROUP=www-data
PROD_DATA_MODE=2770
PROD_PHP_BIN=php8.3
PROD_CADDYFILE=/etc/caddy/Caddyfile
PROD_PHP_FPM_SOCK=/run/php/php8.3-fpm.sock
PROD_CADDY_RELOAD_CMD="sudo caddy reload --config /etc/caddy/Caddyfile"

# Необязательный второй профиль (учебный сервер, локальный деплой):
LAB_MODE=local
LAB_PUBLIC_BASE_URL=https://lab.example.com
LAB_DEPLOY_ROOT=/var/www/b24
LAB_WEB_GROUP=
LAB_DATA_MODE=0777
LAB_PHP_BIN=php8.3
LAB_CADDYFILE=/etc/caddy/Caddyfile
LAB_PHP_FPM_SOCK=/run/php/php8.3-fpm.sock
LAB_CADDY_RELOAD_CMD="/usr/bin/caddy reload --config /etc/caddy/Caddyfile"

# Общие папки знаний (для агента, не для деплоя): грабли и правила Б24 + клон офиц. документации.
# Одни на все проекты; в шаблоне и проектах копий нет.
RULES_B24_DIR=/projects/docs/rules-b24
B24_DOCS_CLONE=/projects/docs/b24-rest-docs
